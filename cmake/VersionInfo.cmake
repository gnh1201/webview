if(WIN32)
  enable_language(RC)
  set_property(GLOBAL PROPERTY YAWW_VERSION_RC_TEMPLATE
    "${CMAKE_CURRENT_LIST_DIR}/yaww_version.rc.in")
  set_property(GLOBAL PROPERTY YAWW_VERSION_STRING "${PROJECT_VERSION}")
  set_property(GLOBAL PROPERTY YAWW_VERSION_MAJOR "${PROJECT_VERSION_MAJOR}")
  set_property(GLOBAL PROPERTY YAWW_VERSION_MINOR "${PROJECT_VERSION_MINOR}")
  set_property(GLOBAL PROPERTY YAWW_VERSION_PATCH "${PROJECT_VERSION_PATCH}")
endif()

function(yaww_add_version_info target)
  if(NOT WIN32)
    return()
  endif()

  get_property(_template GLOBAL PROPERTY YAWW_VERSION_RC_TEMPLATE)
  get_property(_version GLOBAL PROPERTY YAWW_VERSION_STRING)
  get_property(_major GLOBAL PROPERTY YAWW_VERSION_MAJOR)
  get_property(_minor GLOBAL PROPERTY YAWW_VERSION_MINOR)
  get_property(_patch GLOBAL PROPERTY YAWW_VERSION_PATCH)
  get_target_property(_output_name "${target}" OUTPUT_NAME)
  if(NOT _output_name)
    set(_output_name "${target}")
  endif()

  set(YAWW_VERSION_STRING "${_version}")
  set(YAWW_FILE_VERSION "${_major},${_minor},${_patch},0")
  set(YAWW_FILE_DESCRIPTION
    "${_output_name} - YAWW (Yet Another Windows WebView)")
  set(YAWW_ORIGINAL_FILENAME "${_output_name}.exe")
  set(_resource "${CMAKE_CURRENT_BINARY_DIR}/${target}_version.rc")
  configure_file("${_template}" "${_resource}" @ONLY)
  target_sources("${target}" PRIVATE "${_resource}")
endfunction()
